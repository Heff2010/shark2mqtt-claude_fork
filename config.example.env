# Shark account credentials (required)
SHARK_USERNAME=your@email.com
SHARK_PASSWORD=your_password

# Region: "us" or "eu" (default: us)
# SHARK_REGION=us

# SharkNinja household ID (auto-discovered if not set)
# SHARK_HOUSEHOLD_ID=

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT topic prefix (default: shark2mqtt)
# MQTT_PREFIX=shark2mqtt

# Polling interval in seconds (default: 300 = 5 min)
# POLL_INTERVAL=300

# Active polling interval when a vacuum is cleaning (default: 20)
# Matches the vacuum's own undocked report rate
# POLL_INTERVAL_ACTIVE=20

# Operating_Mode value sent for "pause": 1 or 0 (default: 1)
# Some models ignore 1. Note 0 is also "stop" on many models, so test first.
# PAUSE_OPERATING_MODE=1

# Launch the automated browser login when tokens are missing or expired
# (default: true). Set false if you supply tokens from a manual login.
# BROWSER_LOGIN=true

# Directory to persist auth tokens (default: /data)
# TOKEN_DIR=/data

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
